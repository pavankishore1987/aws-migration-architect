<!--[if gte mso 9]><xml><w:WordDocument><w:View>Print</w:View><w:Zoom>100</w:Zoom></w:WordDocument></xml><![endif]-->
<style>
body{font-family:"Segoe UI",Helvetica,Arial,sans-serif;font-size:11pt;color:#1d1f20;line-height:1.5}
h1{font-size:22pt;margin:0 0 4pt}
h2{font-size:15pt;color:#293373;border-bottom:1pt solid #bfc6f0;padding-bottom:3pt;margin:22pt 0 8pt}
h3{font-size:12pt;margin:14pt 0 4pt;color:#3a479c}
p{margin:0 0 8pt}
.meta{color:#5d5d60;font-size:10pt;margin-bottom:16pt}
table{border-collapse:collapse;width:100%;margin:6pt 0 12pt;font-size:10pt}
th{background:#eef0fb;color:#293373;text-align:left;padding:5pt 7pt;border:1pt solid #bfc6f0;font-size:9pt;text-transform:uppercase;letter-spacing:.5pt}
